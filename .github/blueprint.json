{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "landingPage": "/wp-admin/users.php?page=t3admin",
    "preferredVersions": {
        "php": "8.2",
        "wp": "latest"
    },
    "steps": [
        {
            "step": "login",
            "username": "admin",
            "password": "password"
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "git:directory",
                "url": "https://github.com/georgestephanis/t3admin",
                "ref": "HEAD",
                "path": "/"
            },
            "options": {
                "activate": true,
                "targetFolderName": "t3admin"
            }
        },
        {
            "step": "setSiteOptions",
            "options": {
                "blogname": "T3Admin Demo"
            }
        },
        {
            "step": "runPHP",
            "code": "<?php require '/wordpress/wp-load.php'; include_once WP_PLUGIN_DIR . '/t3admin/.github/setup.php';"
        }
    ]
}
